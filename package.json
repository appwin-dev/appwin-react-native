{
  "name": "@appwin/react-native",
  "version": "0.2.0",
  "description": "Appwin React Native SDK - Support, Community and Notifications, rendered by the native iOS and Android SDKs.",
  "types": "lib/typescript/commonjs/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "appwin-react-native.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!**/*.tsbuildinfo",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --import ./__tests__/register.mjs __tests__/*.test.ts",
    "build": "bob build",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "appwin",
    "support",
    "community"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/appwin-dev/appwin-react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appwin-dev/appwin-react-native.git"
  },
  "bugs": {
    "url": "https://github.com/appwin-dev/appwin-react-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.73.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "react-native-builder-bob": "^0.35.3",
    "typescript": "^5.7.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json",
          "esm": true
        }
      ]
    ]
  }
}
